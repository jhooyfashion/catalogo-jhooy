<script>
  // ---- category filter ----
  const pills = document.querySelectorAll('.pill');
  pills.forEach(p => p.addEventListener('click', () => {
    pills.forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    const cat = p.dataset.cat;
    document.querySelectorAll('.cat-block').forEach(block => {
      block.style.display = (cat === 'all' || block.dataset.cat === cat) ? '' : 'none';
    });
    document.querySelectorAll('.cat-heading, .cat-rule').forEach(h => {
      if (cat === 'all') { h.style.display=''; return; }
      h.style.display = (h.dataset.cat === cat) ? '' : 'none';
    });
  }));

  // ---- carousel dots + drag-to-scroll (mouse) ----
  document.querySelectorAll('.carousel').forEach(car => {
    const track = car.querySelector('.carousel-track');
    const dots = car.querySelectorAll('.dot');
    if (dots.length > 1) {
      track.addEventListener('scroll', () => {
        const idx = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach((d,i) => d.classList.toggle('active', i === idx));
      });
    }
    let isDown = false, startX, scrollLeft;
    track.addEventListener('mousedown', e => {
      isDown = true; track.classList.add('dragging');
      startX = e.pageX; scrollLeft = track.scrollLeft;
    });
    ['mouseleave','mouseup'].forEach(evt => track.addEventListener(evt, () => {
      isDown = false; track.classList.remove('dragging');
    }));
    track.addEventListener('mousemove', e => {
      if (!isDown) return;
      e.preventDefault();
      const dx = e.pageX - startX;
      track.scrollLeft = scrollLeft - dx;
    });
  });
</script>
