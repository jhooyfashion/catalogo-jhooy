<style>
  :root{
    --navy:#0A2260;
    --navy-dark:#071A47;
    --gold:#C9A227;
    --gold-light:#E7D28A;
    --bg:#FFFFFF;
    --bg-soft:#F4F5F8;
    --ink:#1F2430;
    --muted:#6B7280;
    --border:#E1E4EA;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Work Sans', sans-serif;
    color:var(--ink);
    background:var(--bg);
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{font-family:'Playfair Display', serif;}
  a{color:inherit;}
  img{max-width:100%;display:block;}

  /* ---------- HERO ---------- */
  .hero{
    background:linear-gradient(180deg, var(--navy) 0%, var(--navy-dark) 100%);
    color:#fff;
    padding:64px 24px 88px;
    text-align:center;
    position:relative;
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute;
    inset:0;
    background:
      radial-gradient(circle at 15% 20%, rgba(201,162,39,0.12) 0%, transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(201,162,39,0.10) 0%, transparent 45%);
    pointer-events:none;
  }
  .hero-inner{position:relative; max-width:720px; margin:0 auto;}
  .hero .eyebrow{
    letter-spacing:4px;
    font-size:12px;
    color:var(--gold-light);
    font-weight:600;
    margin-bottom:20px;
  }
  .hero img.logo{width:150px; height:150px; margin:0 auto 22px; filter:drop-shadow(0 8px 24px rgba(0,0,0,0.35));}
  .hero h1{font-size:clamp(30px,5vw,46px); margin:0 0 12px; font-weight:700;}
  .hero p.tagline{color:#C7CEE0; font-size:16px; font-style:italic; margin:0 0 32px;}
  .hero .cta-row{display:flex; gap:14px; justify-content:center; flex-wrap:wrap;}
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:13px 26px; border-radius:999px;
    font-family:'Work Sans'; font-weight:600; font-size:14px;
    text-decoration:none; cursor:pointer; border:1.5px solid transparent;
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-gold{background:var(--gold); color:var(--navy-dark);}
  .btn-gold:hover{box-shadow:0 10px 24px rgba(201,162,39,0.35);}
  .btn-outline{border-color:rgba(255,255,255,0.4); color:#fff;}
  .btn-outline:hover{border-color:#fff;}

  /* ---------- STICKY NAV ---------- */
  .catnav{
    position:sticky; top:0; z-index:50;
    background:rgba(255,255,255,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
    margin-top:-40px;
  }
  .catnav-scroll{
    display:flex; gap:8px; overflow-x:auto; padding:14px 20px;
    scrollbar-width:none;
  }
  .catnav-scroll::-webkit-scrollbar{display:none;}
  .pill{
    flex-shrink:0; padding:9px 18px; border-radius:999px;
    font-size:13px; font-weight:600; font-family:'Work Sans';
    background:var(--bg-soft); color:var(--navy); cursor:pointer;
    border:1px solid var(--border); white-space:nowrap;
    transition:all .15s ease;
  }
  .pill.active{background:var(--navy); color:#fff; border-color:var(--navy);}
  .pill:hover:not(.active){border-color:var(--gold);}

  /* ---------- COMO FUNCIONA ---------- */
  .info-section{padding:56px 20px 24px; max-width:1100px; margin:0 auto;}
  .info-section h2{font-size:28px; text-align:center; color:var(--navy); margin:0 0 6px;}
  .info-section p.sub{text-align:center; color:var(--muted); font-style:italic; margin:0 0 36px;}
  .info-grid{display:grid; grid-template-columns:repeat(2,1fr); max-width:800px; margin:0 auto; gap:20px;}
  @media (max-width:700px){.info-grid{grid-template-columns:1fr;}}
  .info-card{
    background:var(--bg-soft); border:1px solid var(--border); border-radius:14px;
    padding:26px 24px;
  }
  .info-card .icon{font-size:28px; margin-bottom:14px;}
  .info-card h3{font-size:18px; color:var(--navy); margin:0 0 8px; letter-spacing:0.5px;}
  .info-card p{font-size:14px; color:#374151; margin:0 0 14px; line-height:1.5;}
  .info-card ul{margin:0; padding-left:18px; font-size:13.5px; color:#374151; line-height:1.9;}
  .info-card ul li::marker{color:var(--gold);}

  /* ---------- PRODUCTS ---------- */
  .products-section{max-width:1280px; margin:0 auto; padding:24px 20px 60px;}
  .cat-heading{
    font-size:24px; color:var(--navy); margin:48px 0 4px; padding-top:10px;
    display:flex; align-items:baseline; gap:12px;
  }
  .cat-heading .count{font-family:'Work Sans'; font-size:13px; color:var(--muted); font-weight:500;}
  .cat-rule{height:2px; background:linear-gradient(90deg,var(--gold),transparent); margin-bottom:26px;}
  .grid{
    display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:22px;
  }
  .card{
    border:1px solid var(--border); border-radius:14px; overflow:hidden;
    background:#fff; display:flex; flex-direction:column;
    transition:box-shadow .2s ease, transform .2s ease;
  }
  .card:hover{box-shadow:0 14px 30px rgba(10,34,96,0.10); transform:translateY(-3px);}

  .carousel{position:relative; aspect-ratio:3/4; background:var(--bg-soft); overflow:hidden;}
  .carousel-track{
    display:flex; height:100%; overflow-x:auto; scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch; scrollbar-width:none; cursor:grab;
  }
  .carousel-track::-webkit-scrollbar{display:none;}
  .carousel-track.dragging{cursor:grabbing; scroll-snap-type:none;}
  .carousel-track img, .carousel-track .placeholder{
    flex:0 0 100%; width:100%; height:100%; object-fit:cover; scroll-snap-align:start;
  }
  .placeholder{
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    color:var(--muted); gap:6px; user-select:none; background:
      repeating-linear-gradient(45deg, #F4F5F8, #F4F5F8 10px, #EEF0F4 10px, #EEF0F4 20px);
  }
  .placeholder .cam{font-size:30px;}
  .placeholder span{font-size:11.5px; font-style:italic;}
  .dots{
    position:absolute; bottom:10px; left:0; right:0;
    display:flex; justify-content:center; gap:6px; pointer-events:none;
  }
  .dot{width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,0.55); box-shadow:0 0 0 1px rgba(10,34,96,0.15);}
  .dot.active{background:var(--gold);}
  .cat-tag{
    position:absolute; top:10px; left:10px; background:rgba(10,34,96,0.85); color:#fff;
    font-size:10px; padding:4px 10px; border-radius:999px; letter-spacing:0.5px; font-weight:600;
    pointer-events:none;
  }

  .card-body{padding:14px 14px 16px; display:flex; flex-direction:column; gap:10px; flex:1;}
  .card-body h4{
    font-family:'Work Sans'; font-size:13.5px; font-weight:600; color:var(--ink);
    margin:0; line-height:1.35; min-height:2.6em;
  }
  .price-box{
    background:var(--navy); border-radius:8px; padding:10px 12px;
    display:flex; flex-direction:column; align-items:center; gap:2px; margin-top:auto;
  }
  .price-box .lbl{font-size:9.5px; letter-spacing:1.5px; color:var(--gold-light); font-weight:700;}
  .price-box .val{font-size:17px; color:#fff; font-weight:700;}

  /* ---------- CONTACT ---------- */
  .contact{
    background:linear-gradient(180deg, var(--navy-dark) 0%, var(--navy) 100%);
    color:#fff; padding:64px 20px 48px; text-align:center; margin-top:20px;
  }
  .contact img.logo{width:110px; height:110px; margin:0 auto 20px;}
  .contact h2{font-size:28px; margin:0 0 34px;}
  .contact-grid{
    display:grid; grid-template-columns:repeat(4,1fr); gap:16px; max-width:960px; margin:0 auto;
  }
  @media (max-width:760px){.contact-grid{grid-template-columns:repeat(2,1fr);}}
  .contact-card{
    background:rgba(255,255,255,0.06); border:1px solid rgba(201,162,39,0.4); border-radius:12px;
    padding:20px 14px;
  }
  .contact-card .lbl{font-size:11px; letter-spacing:2px; color:var(--gold-light); font-weight:700; margin-bottom:8px;}
  .contact-card .val{font-size:14px; color:#fff;}
  .contact .note{margin-top:32px; font-size:12.5px; color:var(--gold-light); font-style:italic;}
  .contact .foot{margin-top:36px; font-size:11.5px; color:#8792AD;}

  /* ---------- FLOATING WHATSAPP ---------- */
  .float-cta{
    position:fixed; bottom:22px; right:22px; z-index:60;
    background:#25D366; color:#fff; border-radius:999px;
    width:56px; height:56px; display:flex; align-items:center; justify-content:center;
    font-size:26px; text-decoration:none; box-shadow:0 10px 26px rgba(0,0,0,0.25);
