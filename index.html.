  }
  @media (prefers-reduced-motion: reduce){ .float-cta{animation:none;} html{scroll-behavior:auto;} }
  @keyframes pulse{
    0%,100%{box-shadow:0 10px 26px rgba(0,0,0,0.25);}
    50%{box-shadow:0 10px 26px rgba(0,0,0,0.25), 0 0 0 10px rgba(37,211,102,0.15);}
  }
</style>
</head>
